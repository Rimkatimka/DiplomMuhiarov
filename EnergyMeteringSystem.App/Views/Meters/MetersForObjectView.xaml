<Window x:Class="EnergyMeteringSystem.App.Views.Meters.MetersForObjectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Счётчики объекта" 
        Height="500" Width="900"
        MinHeight="400"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>

        <!-- Базовый стиль кнопок -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопки "Добавить" (зелёный) -->
        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66BB6A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопки "Редактировать" (синий - из темы) -->
        <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопки "Удалить" (красный) -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#F44336"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF5350"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопки "Закрыть" (серый) -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#757575"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9E9E9E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#616161"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Информация об объекте -->
        <Border Grid.Row="0" 
                Background="{DynamicResource MenuCardBackgroundBrush}" 
                Padding="10" 
                CornerRadius="5" 
                Margin="0,0,0,10">
            <TextBlock Text="{Binding ObjectAddress}" 
                       FontSize="14" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource MenuForegroundBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Таблица счётчиков -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Meters}"
                  SelectedItem="{Binding SelectedMeter}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingBrush}"
                  AlternationCount="2"
                  BorderBrush="{DynamicResource DataGridBorderBrush}"
                  BorderThickness="1"
                  Background="{DynamicResource DataGridBackgroundBrush}"
                  RowHeaderWidth="0"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Серийный номер" 
                                    Binding="{Binding SerialNumber}" 
                                    Width="140"/>

                <DataGridTextColumn Header="Тип" 
                                    Binding="{Binding MeterTypeName}" 
                                    Width="130"/>

                <DataGridTextColumn Header="Дата установки" 
                                    Binding="{Binding InstallationDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                    Width="100"/>

                <DataGridTextColumn Header="Поверка до" 
                                    Binding="{Binding NextVerificationDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding VerificationStatusColor}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Статус" 
                                    Binding="{Binding StatusName}" 
                                    Width="90"/>

                <DataGridTextColumn Header="Срок службы" 
                                    Binding="{Binding ServiceLifeText}" 
                                    Width="90"/>

                <DataGridTextColumn Header="Дата изъятия" 
                                    Binding="{Binding RemovalDateText}" 
                                    Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления с семантическими цветами -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="➕ Добавить" 
                    Command="{Binding AddMeterCommand}"
                    Style="{StaticResource AddButtonStyle}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="✏ Редактировать" 
                    Command="{Binding EditMeterCommand}"
                    Style="{StaticResource EditButtonStyle}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="🗑 Удалить" 
                    Command="{Binding DeleteMeterCommand}"
                    Style="{StaticResource DeleteButtonStyle}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="✖ Закрыть" 
                    Click="CloseButton_Click"
                    Style="{StaticResource CloseButtonStyle}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Индикатор загрузки -->
        <Border Grid.RowSpan="3" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="20"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                <TextBlock Text="Загрузка счетчиков..." 
                           Margin="0,10,0,0" 
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>