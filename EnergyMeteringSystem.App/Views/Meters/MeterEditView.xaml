<Window x:Class="EnergyMeteringSystem.App.Views.Meters.MeterEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EnergyMeteringSystem.App.Converters"
        Title="Регистрация счетчика" 
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="550"
        MinHeight="650"
        MaxWidth="800"
        MaxHeight="900">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Серийный номер -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Серийный номер:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" 
                     MaxLength="30"
                     Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="5" Padding="5"
                     PreviewTextInput="TextBox_PreviewTextInput_Alphanumeric"
                     PreviewKeyDown="TextBox_PreviewKeyDown_BlockSpace"/>

            <!-- Тип счетчика -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип счетчика:" Margin="5" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" 
                      ItemsSource="{Binding MeterTypes}"
                      SelectedItem="{Binding SelectedMeterType}"
                      DisplayMemberPath="Name"
                      Margin="5" Padding="5"/>

            <!-- Текущий объект -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Текущий объект:" Margin="5" VerticalAlignment="Center"/>
            <Border Grid.Row="2" Grid.Column="1" 
                    Background="#F5F5F5" 
                    CornerRadius="3" 
                    Padding="5" 
                    Margin="5"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <TextBlock Text="{Binding SelectedObject.Address, TargetNullValue=Не выбран}" 
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Чекбокс "Изменить объект" -->
            <CheckBox Grid.Row="3" Grid.Column="1" 
                      Content="✏ Изменить объект установки"
                      IsChecked="{Binding IsChangeObjectMode}"
                      Margin="5,5,5,10"
                      FontWeight="SemiBold"
                      Foreground="#1976D2"/>

            <!-- Расширенные настройки -->
            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="#FFF9C4"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsChangeObjectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="📌 Новый объект установки" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"
                               Foreground="#E65100"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Регион:" Width="60" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Regions}"
                                  SelectedItem="{Binding SelectedRegion}"
                                  DisplayMemberPath="Name"
                                  Width="250"
                                  Margin="5,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Город:" Width="60" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Cities}"
                                  SelectedItem="{Binding SelectedCity}"
                                  DisplayMemberPath="Name"
                                  Width="250"
                                  Margin="5,0,0,0"
                                  IsEnabled="{Binding SelectedRegion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Улица:" Width="60" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Streets}"
                                  SelectedItem="{Binding SelectedStreet}"
                                  DisplayMemberPath="Name"
                                  Width="250"
                                  Margin="5,0,0,0"
                                  IsEnabled="{Binding SelectedCity, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Объект:" Width="60" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding FilteredObjects}"
                                  SelectedItem="{Binding SelectedNewObject}"
                                  DisplayMemberPath="Address"
                                  Width="250"
                                  Margin="5,0,0,0"
                                  IsEnabled="{Binding SelectedStreet, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Дата установки -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата установки:" Margin="5" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="5" Grid.Column="1" 
                        SelectedDate="{Binding InstallationDate}" 
                        DisplayDateStart="{Binding MinInstallationDate, Mode=OneWay}"
                        DisplayDateEnd="{Binding MaxInstallationDate, Mode=OneWay}"
                        Margin="5" Padding="5"/>

            <!-- Начальные показания -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Начальные показания:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" 
                     Text="{Binding InitialReading, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="5" Padding="5"
                     MaxLength="10"
                     PreviewTextInput="TextBox_PreviewTextInput_Decimal"
                     PreviewKeyDown="TextBox_PreviewKeyDown_BlockSpace"/>

            <!-- Дата последней поверки -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Дата последней поверки:" Margin="5" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="7" Grid.Column="1" 
                        SelectedDate="{Binding LastVerificationDate}"
                        DisplayDateStart="{Binding MinInstallationDate, Mode=OneWay}"
                        DisplayDateEnd="{Binding MaxInstallationDate, Mode=OneWay}"
                        IsEnabled="{Binding IsEditMode}"
                        Margin="5" Padding="5"/>

            <!-- Дата следующей поверки -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Дата следующей поверки:" Margin="5" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="8" Grid.Column="1" 
                        SelectedDate="{Binding NextVerificationDate}"
                        DisplayDateStart="{Binding MinNextVerificationDate, Mode=OneWay}"
                        DisplayDateEnd="{Binding MaxNextVerificationDate, Mode=OneWay}"
                        Margin="5" Padding="5"/>

            <!-- Срок службы -->
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Срок службы (лет):" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="9" Grid.Column="1" 
                     Text="{Binding ServiceLifeYears}" 
                     Margin="5" Padding="5"
                     IsReadOnly="True"
                     Background="#F0F0F0"/>

            <!-- Дата изъятия -->
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Дата изъятия (авто):" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="10" Grid.Column="1" 
                     Text="{Binding RemovalDate, StringFormat={}{0:dd.MM.yyyy}, TargetNullValue=—}" 
                     Margin="5" Padding="5"
                     IsReadOnly="True"
                     Background="#F5F5F5"
                     Foreground="Gray"/>

            <!-- Статус счетчика -->
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Статус:" Margin="5" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="11" Grid.Column="1" 
                      ItemsSource="{Binding Statuses}"
                      SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="Name"
                      Margin="5" Padding="5"/>

            <!-- Сообщение об ошибке дат -->
            <TextBlock Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" 
                       Text="{Binding DateError}"
                       Foreground="Red"
                       FontSize="12"
                       Margin="5"
                       HorizontalAlignment="Center"
                       Visibility="{Binding HasDateError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Сохранить" 
                        Command="{Binding SaveCommand}"
                        Padding="20,8" Margin="5"
                        Background="#4CAF50" Foreground="White"
                        IsEnabled="{Binding CanSave}"/>
                <Button Content="Отмена" 
                        Command="{Binding CancelCommand}"
                        Padding="20,8" Margin="5"/>
            </StackPanel>

            <!-- Индикатор загрузки -->
            <Border Grid.RowSpan="15" Grid.ColumnSpan="2" 
                    Background="#80000000" 
                    Visibility="{Binding IsLoadingData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="20"/>
                    <TextBlock Text="Загрузка..." Margin="0,10,0,0" Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>