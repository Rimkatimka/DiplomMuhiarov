<UserControl x:Class="EnergyMeteringSystem.App.Views.Objects.ConsumptionObjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск по адресу -->
        <TextBox Grid.Row="0" 
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                 Width="300" 
                 Padding="8,6"
                 Margin="0,0,0,10"
                 VerticalAlignment="Center"
                 FontSize="13"
                 ToolTip="Поиск по адресу"/>

        <!-- Каскадные фильтры -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Регион:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <ComboBox ItemsSource="{Binding Regions}" 
                      SelectedItem="{Binding SelectedRegionFilter}"
                      DisplayMemberPath="Name"
                      Width="180"
                      Margin="0,0,15,0"/>

            <TextBlock Text="Город:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <ComboBox ItemsSource="{Binding CitiesFilter}" 
                      SelectedItem="{Binding SelectedCityFilter}"
                      DisplayMemberPath="Name"
                      Width="180"
                      Margin="0,0,15,0"
                      IsEnabled="{Binding SelectedRegionFilter, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="Улица:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <ComboBox ItemsSource="{Binding StreetsFilter}" 
                      SelectedItem="{Binding SelectedStreetFilter}"
                      DisplayMemberPath="Name"
                      Width="180"
                      Margin="0,0,15,0"
                      IsEnabled="{Binding SelectedCityFilter, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="Сбросить фильтр" 
                    Command="{Binding ClearFiltersCommand}"
                    Padding="10,5"
                    Margin="10,0,0,0"
                    ToolTip="Сбросить все фильтры"/>
        </WrapPanel>

        <!-- Таблица объектов -->
        <DataGrid Grid.Row="2" 
          ItemsSource="{Binding FilteredItems}"
          SelectedItem="{Binding SelectedItem}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          AlternatingRowBackground="{DynamicResource DataGridAlternatingBrush}"
          AlternationCount="2"
          Background="{DynamicResource DataGridBackgroundBrush}"
          BorderBrush="{DynamicResource DataGridBorderBrush}"
          RowHeaderWidth="0"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
          CellStyle="{StaticResource DataGridCellStyle}">

            <DataGrid.Resources>
                <!-- Переопределяем стили для колонок и ячеек -->
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>

                <!-- Стиль для кнопок внутри DataGrid (использует тему из App.xaml) -->
                <Style TargetType="Button">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*" MinWidth="300"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ObjectTypeName}" Width="120"/>
                <DataGridTextColumn Header="Площадь, м²" Binding="{Binding TotalArea, StringFormat={}{0:F1}}" Width="100"/>
                <DataGridTextColumn Header="Жильцов" Binding="{Binding ResidentCount}" Width="80"/>

                <DataGridTemplateColumn Header="Счетчики" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Просмотр"
                            Command="{Binding DataContext.ShowMetersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="{Binding}"
                            Padding="8,4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить" 
                    Command="{Binding AddCommand}"
                    Padding="15,8" Margin="5"
                    Background="#4CAF50" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="Редактировать" 
                    Command="{Binding EditCommand}"
                    Padding="15,8" Margin="5"
                    Background="#2196F3" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="Удалить" 
                    Command="{Binding DeleteCommand}"
                    Padding="15,8" Margin="5"
                    Background="#F44336" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- Индикатор загрузки -->
        <Border Grid.RowSpan="4" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20"/>
                <TextBlock Text="Загрузка объектов..." Margin="0,10,0,0" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>