<UserControl x:Class="EnergyMeteringSystem.App.Views.Objects.ConsumptionObjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <TextBox Grid.Row="0" 
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                 Width="300" 
                 Padding="8,6"
                 Margin="0,0,0,10"
                 VerticalAlignment="Center"
                 FontSize="13"
                 ToolTip="Поиск по адресу"/>

        <!-- Таблица объектов -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding FilteredItems}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  AlternatingRowBackground="#F5F5F5"
                  AlternationCount="2">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*" MinWidth="300"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding ObjectTypeName}" Width="120"/>
                <DataGridTextColumn Header="Площадь, м²" Binding="{Binding TotalArea, StringFormat={}{0:F1}}" Width="100"/>
                <DataGridTextColumn Header="Жильцов" Binding="{Binding ResidentCount}" Width="80"/>

                <DataGridTemplateColumn Header="Счетчики" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Просмотр"
                                    Command="{Binding DataContext.ShowMetersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Padding="8,4"
                                    Background="#2196F3"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить" 
                    Command="{Binding AddCommand}"
                    Padding="15,8" Margin="5"
                    Background="#4CAF50" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="Редактировать" 
                    Command="{Binding EditCommand}"
                    Padding="15,8" Margin="5"
                    Background="#2196F3" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="Удалить" 
                    Command="{Binding DeleteCommand}"
                    Padding="15,8" Margin="5"
                    Background="#F44336" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

        <!-- Индикатор загрузки -->
        <Border Grid.RowSpan="3" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20"/>
                <TextBlock Text="Загрузка объектов..." Margin="0,10,0,0" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>