<UserControl x:Class="EnergyMeteringSystem.App.Views.Reports.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:converters="clr-namespace:EnergyMeteringSystem.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource MenuBackgroundBrush}" 
                    Padding="15" 
                    Margin="0,0,0,15"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentReportTitle}" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="{DynamicResource MenuForegroundBrush}"/>
                    <TextBlock Text="Система учета электроэнергии" 
                               FontSize="11" 
                               Foreground="{DynamicResource MenuForegroundSecondaryBrush}" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Панель параметров -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource DataGridBackgroundBrush}" 
                    Padding="15" 
                    Margin="0,0,0,15"
                    BorderBrush="{DynamicResource DataGridBorderBrush}" 
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="Отчет:" 
                                   VerticalAlignment="Center" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource DataGridForegroundBrush}"/>
                        <ComboBox Width="250" 
                                  Margin="0,0,20,0"
                                  SelectedValue="{Binding SelectedReportType}"
                                  SelectedValuePath="Tag"
                                  Background="{DynamicResource DataGridBackgroundBrush}"
                                  Foreground="{DynamicResource DataGridForegroundBrush}"
                                  BorderBrush="{DynamicResource DataGridBorderBrush}">
                            <ComboBoxItem Content="📊 Потребление за период" Tag="0"/>
                            <ComboBoxItem Content="🏆 ТОП-10 объектов" Tag="1"/>
                            <ComboBoxItem Content="📈 Потребление по типам" Tag="2"/>
                            <ComboBoxItem Content="📉 Динамика по месяцам" Tag="3"/>
                            <ComboBoxItem Content="🗺️ Потребление по регионам" Tag="4"/>
                            <ComboBoxItem Content="⚠️ Аномалии потребления" Tag="5"/>
                            <ComboBoxItem Content="🔧 Счетчики с поверкой" Tag="6"/>
                            <ComboBoxItem Content="👥 Активность операторов" Tag="7"/>
                            <ComboBoxItem Content="📐 Аналитика по объектам" Tag="8"/>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" 
                                    Visibility="{Binding ShowPeriodFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Период:" 
                                       FontWeight="SemiBold" 
                                       Margin="15,0,10,0" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DataGridForegroundBrush}"/>

                            <TextBlock Text="С:" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,5,0"
                                       Foreground="{DynamicResource DataGridForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding Years}" 
                                      SelectedItem="{Binding StartYear}" 
                                      Width="80" 
                                      Margin="0,0,5,0"
                                      Background="{DynamicResource DataGridBackgroundBrush}"
                                      Foreground="{DynamicResource DataGridForegroundBrush}"
                                      BorderBrush="{DynamicResource DataGridBorderBrush}"/>
                            <ComboBox ItemsSource="{Binding Months}" 
                                      SelectedItem="{Binding StartMonthName}" 
                                      Width="100" 
                                      Margin="0,0,15,0"
                                      Background="{DynamicResource DataGridBackgroundBrush}"
                                      Foreground="{DynamicResource DataGridForegroundBrush}"
                                      BorderBrush="{DynamicResource DataGridBorderBrush}"/>

                            <TextBlock Text="по:" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,5,0"
                                       Foreground="{DynamicResource DataGridForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding Years}" 
                                      SelectedItem="{Binding EndYear}" 
                                      Width="80" 
                                      Margin="0,0,5,0"
                                      Background="{DynamicResource DataGridBackgroundBrush}"
                                      Foreground="{DynamicResource DataGridForegroundBrush}"
                                      BorderBrush="{DynamicResource DataGridBorderBrush}"/>
                            <ComboBox ItemsSource="{Binding Months}" 
                                      SelectedItem="{Binding EndMonthName}" 
                                      Width="100"
                                      Background="{DynamicResource DataGridBackgroundBrush}"
                                      Foreground="{DynamicResource DataGridForegroundBrush}"
                                      BorderBrush="{DynamicResource DataGridBorderBrush}"/>
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="Вид:" 
                                   VerticalAlignment="Center" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource DataGridForegroundBrush}"/>

                        <RadioButton Content="📊 Таблица" 
                                     IsChecked="{Binding IsTableMode}" 
                                     GroupName="ViewMode" 
                                     Margin="0,0,10,0" 
                                     Padding="5,3"
                                     Foreground="{DynamicResource DataGridForegroundBrush}"/>

                        <RadioButton Content="📈 Таблица + График" 
                                     IsChecked="{Binding IsChartMode}" 
                                     IsEnabled="{Binding CanShowChart}"
                                     GroupName="ViewMode" 
                                     Margin="0,0,10,0" 
                                     Padding="5,3"
                                     Foreground="{DynamicResource DataGridForegroundBrush}"/>

                        <Button Content="📎 Экспорт в Excel" 
                                Command="{Binding ExportCommand}"
                                Padding="15,8" 
                                Margin="30,0,0,0"
                                Background="{StaticResource SuccessButtonBrush}" 
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontWeight="SemiBold"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Таблица -->
            <DataGrid Grid.Row="2" 
                      x:Name="MainDataGrid" 
                      ItemsSource="{Binding CurrentData}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      Margin="0,0,0,10"
                      MinHeight="200"
                      MaxHeight="400"
                      AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                      AlternatingRowBackground="{DynamicResource DataGridAlternatingBrush}"
                      AlternationCount="2"
                      Background="{DynamicResource DataGridBackgroundBrush}"
                      BorderBrush="{DynamicResource DataGridBorderBrush}"
                      RowHeaderWidth="0"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"/>

            <!-- Графики -->
            <Border Grid.Row="3" 
                    Background="{DynamicResource DataGridAlternatingBrush}" 
                    Padding="15" 
                    Margin="0,0,0,15"
                    BorderBrush="{DynamicResource DataGridBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="{Binding IsChartMode, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ТОП-10 объектов -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource DataGridBackgroundBrush}" 
                            Padding="15" 
                            Margin="0,0,0,15"
                            BorderBrush="{DynamicResource DataGridBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Visibility="{Binding ShowTopChart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="🏆 ТОП-10 объектов по потреблению" 
                                       FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource DataGridForegroundBrush}"/>
                            <lvc:CartesianChart Series="{Binding TopObjectsSeries}" 
                                                LegendLocation="Top"
                                                Height="300"
                                                DisableAnimations="True"
                                                Background="{DynamicResource DataGridBackgroundBrush}"
                                                Foreground="{DynamicResource DataGridForegroundBrush}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Объект" 
                                              Labels="{Binding TopObjectsLabels}" 
                                              ShowLabels="False"
                                              Foreground="{DynamicResource DataGridForegroundBrush}"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Потребление (кВт·ч)" 
                                              LabelFormatter="{Binding XFormatter}"
                                              Foreground="{DynamicResource DataGridForegroundBrush}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Stroke="{DynamicResource DataGridCellBorderBrush}"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </Border>

                    <!-- Распределение по типам -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource DataGridBackgroundBrush}" 
                            Padding="15"
                            BorderBrush="{DynamicResource DataGridBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Visibility="{Binding ShowTypeDistributionChart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="📊 Распределение по типам объектов" 
                                       FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource DataGridForegroundBrush}"/>

                            <lvc:PieChart Series="{Binding TypeDistributionSeries}" 
                                          Height="350" 
                                          Width="500"
                                          LegendLocation="Right"
                                          HorizontalAlignment="Center"
                                          Background="{DynamicResource DataGridBackgroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Динамика по месяцам -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource DataGridBackgroundBrush}" 
                            Padding="15"
                            BorderBrush="{DynamicResource DataGridBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Visibility="{Binding ShowMonthlyChart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="📈 Динамика потребления по месяцам" 
                                       FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource DataGridForegroundBrush}"/>
                            <lvc:CartesianChart Series="{Binding MonthlySeries}" 
                                                Height="350"
                                                Background="{DynamicResource DataGridBackgroundBrush}"
                                                Foreground="{DynamicResource DataGridForegroundBrush}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Месяц" 
                                              Labels="{Binding MonthLabels}"
                                              Foreground="{DynamicResource DataGridForegroundBrush}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Stroke="{DynamicResource DataGridCellBorderBrush}"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Потребление (кВт·ч)" 
                                              LabelFormatter="{Binding XFormatter}"
                                              Foreground="{DynamicResource DataGridForegroundBrush}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Stroke="{DynamicResource DataGridCellBorderBrush}"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>