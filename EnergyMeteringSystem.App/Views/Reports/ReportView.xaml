<UserControl x:Class="EnergyMeteringSystem.App.Views.Reports.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#2D3F5E" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentReportTitle}" 
                               FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Система учета электроэнергии" 
                               FontSize="11" Foreground="#B0C4DE" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Панель параметров -->
            <Border Grid.Row="1" Background="White" Padding="15" Margin="0,0,0,15"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="Отчет:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <ComboBox Width="250" Margin="0,0,20,0"
                                  SelectedValue="{Binding SelectedReportType}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="📊 Потребление за период" Tag="0"/>
                            <ComboBoxItem Content="🏆 ТОП-10 объектов" Tag="1"/>
                            <ComboBoxItem Content="📈 Потребление по типам" Tag="2"/>
                            <ComboBoxItem Content="📉 Динамика по месяцам" Tag="3"/>
                            <ComboBoxItem Content="🗺️ Потребление по регионам" Tag="4"/>
                            <ComboBoxItem Content="⚠️ Аномалии потребления" Tag="5"/>
                            <ComboBoxItem Content="🔧 Счетчики с поверкой" Tag="6"/>
                            <ComboBoxItem Content="👥 Активность операторов" Tag="7"/>
                            <ComboBoxItem Content="📐 Аналитика по объектам" Tag="8"/>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" 
                                    Visibility="{Binding ShowPeriodFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Период:" FontWeight="SemiBold" Margin="15,0,10,0" VerticalAlignment="Center"/>

                            <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding StartYear}" Width="80" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding StartMonthName}" Width="100" Margin="0,0,15,0"/>

                            <TextBlock Text="по:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding EndYear}" Width="80" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding EndMonthName}" Width="100"/>
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="Вид:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>

                        <RadioButton Content="📊 Таблица" 
                                     IsChecked="{Binding IsTableMode}" 
                                     GroupName="ViewMode" 
                                     Margin="0,0,10,0" 
                                     Padding="5,3"/>

                        <RadioButton Content="📈 Таблица + График" 
                                     IsChecked="{Binding IsChartMode}" 
                                     IsEnabled="{Binding CanShowChart}"
                                     GroupName="ViewMode" 
                                     Margin="0,0,10,0" 
                                     Padding="5,3"/>

                        <Button Content="📎 Экспорт в Excel" 
                                Command="{Binding ExportCommand}"
                                Padding="15,8" Margin="30,0,0,0"
                                Background="#4CAF50" Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Таблица -->
            <DataGrid Grid.Row="2" x:Name="MainDataGrid" 
                      ItemsSource="{Binding CurrentData}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      Margin="0,0,0,10"
                      MinHeight="200"
                      MaxHeight="400"
                      AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"/>

            <!-- Графики -->
            <Border Grid.Row="3" Background="#F5F5F5" Padding="15" Margin="0,0,0,15"
                    Visibility="{Binding IsChartMode, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ТОП-10 объектов -->
                    <Border Grid.Row="0" Background="#FAFAFA" Padding="15" Margin="0,0,0,15"
                            Visibility="{Binding ShowTopChart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="🏆 ТОП-10 объектов по потреблению" 
                                       FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,10"/>
                            <lvc:CartesianChart Series="{Binding TopObjectsSeries}" 
                                                LegendLocation="Top"
                                                Height="300"
                                                DisableAnimations="True">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Объект" Labels="{Binding TopObjectsLabels}" ShowLabels="False"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Потребление (кВт·ч)" LabelFormatter="{Binding XFormatter}"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </Border>

                    <!-- Распределение по типам -->
                    <Border Grid.Row="1" Background="#FAFAFA" Padding="15"
                            Visibility="{Binding ShowTypeDistributionChart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="📊 Распределение по типам объектов" 
                                       FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,10"/>

                            <lvc:PieChart Series="{Binding TypeDistributionSeries}" 
                                          Height="350" 
                                          Width="500"
                                          LegendLocation="Right"
                                          HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Динамика по месяцам -->
                    <Border Grid.Row="0" Background="#FAFAFA" Padding="15"
                            Visibility="{Binding ShowMonthlyChart, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="📈 Динамика потребления по месяцам" 
                                       FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,10"/>
                            <lvc:CartesianChart Series="{Binding MonthlySeries}" Height="350">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Месяц" Labels="{Binding MonthLabels}"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Потребление (кВт·ч)" LabelFormatter="{Binding XFormatter}"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>