<UserControl x:Class="EnergyMeteringSystem.App.Views.Main.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:conv="clr-namespace:EnergyMeteringSystem.App.Converters">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- KPI Карточки - 6 штук в 2 ряда -->
                <StackPanel>
                    <!-- Первый ряд -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Объекты -->
                        <Border Grid.Column="0" 
                                Background="{StaticResource ButtonBackgroundBrush}" 
                                Padding="20" Margin="5" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Объекты" Foreground="White" FontSize="13" Opacity="0.9"/>
                                <TextBlock Text="{Binding TotalObjects}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Счётчики -->
                        <Border Grid.Column="1" 
                                Background="{StaticResource SuccessButtonBrush}" 
                                Padding="20" Margin="5" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Счётчики" Foreground="White" FontSize="13" Opacity="0.9"/>
                                <TextBlock Text="{Binding TotalMeters}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Показаний сегодня -->
                        <Border Grid.Column="2" 
                                Background="#E65100" 
                                Padding="20" Margin="5" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Показаний сегодня" Foreground="White" FontSize="13" Opacity="0.9"/>
                                <TextBlock Text="{Binding ReadingsToday}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Второй ряд -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Просрочено поверок -->
                        <Border Grid.Column="0" 
                                Background="{StaticResource DangerButtonBrush}" 
                                Padding="20" Margin="5" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Просрочено поверок" Foreground="White" FontSize="13" Opacity="0.9"/>
                                <TextBlock Text="{Binding ExpiredMeters}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Потребление за месяц -->
                        <Border Grid.Column="1" 
                                Background="#008080" 
                                Padding="20" Margin="5" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Потребление за месяц" Foreground="White" FontSize="13" Opacity="0.9"/>
                                <TextBlock Text="{Binding MonthlyConsumption, StringFormat={}{0:N0} кВт·ч}" 
                                           Foreground="White" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Среднее на объект -->
                        <Border Grid.Column="2" 
                                Background="#00ACC1" 
                                Padding="20" Margin="5" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Среднее на объект" Foreground="White" FontSize="13" Opacity="0.9"/>
                                <TextBlock Text="{Binding AveragePerObject, StringFormat={}{0:N0} кВт·ч}" 
                                           Foreground="White" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Панель выбора года -->
                <Border Background="{DynamicResource DataGridAlternatingBrush}" 
                        Padding="15" Margin="0,30,0,15" CornerRadius="8"
                        BorderBrush="{DynamicResource DataGridBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Год:" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource DataGridForegroundBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableYears}" 
                                  SelectedItem="{Binding SelectedYear}"
                                  Width="100" Height="30"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource DataGridBackgroundBrush}"
                                  Foreground="{DynamicResource DataGridForegroundBrush}"
                                  BorderBrush="{DynamicResource DataGridBorderBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Заголовок графика -->
                <TextBlock Text="{Binding ChartTitle}" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource DataGridForegroundBrush}"/>


                <!-- График (всегда видим) -->
                <Border Background="#F5F5F5" Padding="20" CornerRadius="10">
                    <lvc:CartesianChart Series="{Binding ChartSeries}" LegendLocation="Top" Height="350">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Месяц" Labels="{Binding ChartMonths}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Потребление, кВт·ч" LabelFormatter="{Binding YFormatter}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Индикатор загрузки -->
        <Border Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="20"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                <TextBlock Text="Загрузка дашборда..." 
                           Margin="0,10,0,0" 
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>