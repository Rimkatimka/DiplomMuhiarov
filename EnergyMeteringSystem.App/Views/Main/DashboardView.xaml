<UserControl x:Class="EnergyMeteringSystem.App.Views.Main.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:converters="clr-namespace:EnergyMeteringSystem.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Конвертер для обратного Boolean (с использованием существующего) -->
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      Padding="20"
                      IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <!-- KPI Карточки - теперь используют тему -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Карточка "Объекты" - бирюзовая -->
                    <Border Grid.Column="0" 
                            Background="{StaticResource ButtonBackgroundBrush}" 
                            Padding="20" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Объекты" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{Binding TotalObjects}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка "Счётчики" - зелёная (семантическая) -->
                    <Border Grid.Column="1" 
                            Background="{StaticResource SuccessButtonBrush}" 
                            Padding="20" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Счётчики" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{Binding TotalMeters}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка "Показаний сегодня" - оранжевая (акцент) -->
                    <Border Grid.Column="2" 
                            Background="#E65100" 
                            Padding="20" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Показаний сегодня" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{Binding ReadingsToday}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка "Поверка истекла" - красная (опасность) -->
                    <Border Grid.Column="3" 
                            Background="{StaticResource DangerButtonBrush}" 
                            Padding="20" Margin="5" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Поверка истекла" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{Binding ExpiredMeters}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Заголовок графика -->
                <TextBlock Text="{Binding ChartTitle}" 
                           FontSize="18" FontWeight="Bold" 
                           Foreground="{DynamicResource DataGridForegroundBrush}"
                           HorizontalAlignment="Center" 
                           Margin="0,20,0,10"/>

                <!-- График - фон из темы -->
                <Border Background="{DynamicResource DataGridAlternatingBrush}" 
                        Padding="20" CornerRadius="10"
                        BorderBrush="{DynamicResource DataGridBorderBrush}"
                        BorderThickness="1">
                    <lvc:CartesianChart Series="{Binding ChartSeries}" 
                                        LegendLocation="Top" 
                                        Height="350"
                                        DisableAnimations="True"
                                        Background="{DynamicResource DataGridBackgroundBrush}"
                                        Foreground="{DynamicResource DataGridForegroundBrush}">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Месяц" 
                                      Labels="{Binding ChartMonths}"
                                      Foreground="{DynamicResource DataGridForegroundBrush}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1" 
                                                   Stroke="{DynamicResource DataGridCellBorderBrush}"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Количество показаний" 
                                      LabelFormatter="{Binding YFormatter}"
                                      Foreground="{DynamicResource DataGridForegroundBrush}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Stroke="{DynamicResource DataGridCellBorderBrush}"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Border>

                <!-- Сообщение если нет данных -->
                <TextBlock Text="Нет данных для отображения графика" 
                           FontSize="14" 
                           Foreground="{DynamicResource MenuForegroundSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Visibility="{Binding HasData, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Inverse}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Индикатор загрузки -->
        <Border Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="20"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                <TextBlock Text="Загрузка дашборда..." 
                           Margin="0,10,0,0" 
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>