<UserControl x:Class="EnergyMeteringSystem.App.Views.Admin.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EnergyMeteringSystem.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Резервное копирование базы данных" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"
                   Foreground="{DynamicResource DataGridForegroundBrush}"/>

        <!-- Создание бэкапа -->
        <Border Grid.Row="1" 
                Background="{DynamicResource DataGridAlternatingBrush}" 
                Padding="10" 
                CornerRadius="5" 
                Margin="0,0,0,15"
                BorderBrush="{DynamicResource DataGridBorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📀 СОЗДАНИЕ РЕЗЕРВНОЙ КОПИИ" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource DataGridForegroundBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding BackupPath}" 
                             Width="400" 
                             Padding="8,6" 
                             Margin="5"
                             IsReadOnly="True"
                             Background="{DynamicResource DataGridBackgroundBrush}"
                             Foreground="{DynamicResource DataGridForegroundBrush}"
                             BorderBrush="{DynamicResource DataGridBorderBrush}"/>
                    <Button Content="Обзор" 
                            Command="{Binding BrowseBackupCommand}"
                            Padding="15,5" 
                            Margin="5"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"/>
                </StackPanel>
                <Button Content="Создать резервную копию" 
                        Command="{Binding CreateBackupCommand}"
                        Padding="20,8" 
                        Margin="5,10,5,5"
                        Background="{StaticResource SuccessButtonBrush}" 
                        Foreground="White"
                        Width="200" 
                        HorizontalAlignment="Left"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Восстановление из бэкапа -->
        <Border Grid.Row="2" 
                Background="{DynamicResource DataGridSelectedBrush}" 
                Padding="10" 
                CornerRadius="5" 
                Margin="0,0,0,15"
                BorderBrush="{StaticResource DangerButtonBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🔄 ВОССТАНОВЛЕНИЕ ИЗ РЕЗЕРВНОЙ КОПИИ" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource DataGridForegroundBrush}"/>
                <TextBlock Text="ВНИМАНИЕ: Восстановление заменит все текущие данные!" 
                           Foreground="{StaticResource DangerButtonBrush}" 
                           FontSize="11" 
                           Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding RestorePath}" 
                             Width="400" 
                             Padding="8,6" 
                             Margin="5"
                             IsReadOnly="True"
                             Background="{DynamicResource DataGridBackgroundBrush}"
                             Foreground="{DynamicResource DataGridForegroundBrush}"
                             BorderBrush="{DynamicResource DataGridBorderBrush}"/>
                    <Button Content="Выбрать файл" 
                            Command="{Binding BrowseRestoreCommand}"
                            Padding="15,5" 
                            Margin="5"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"/>
                </StackPanel>
                <Button Content="Восстановить из копии" 
                        Command="{Binding RestoreCommand}"
                        Padding="20,8" 
                        Margin="5,10,5,5"
                        Background="{StaticResource DangerButtonBrush}" 
                        Foreground="White"
                        Width="200" 
                        HorizontalAlignment="Left"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Статус -->
        <Border Grid.Row="3" 
                Background="{DynamicResource DataGridSelectedBrush}" 
                Padding="10" 
                CornerRadius="5"
                BorderBrush="{DynamicResource DataGridBorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📊 СТАТУС" 
                           FontWeight="Bold" 
                           Margin="0,0,0,5"
                           Foreground="{DynamicResource DataGridForegroundBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" 
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DataGridForegroundBrush}"/>
                <ProgressBar IsIndeterminate="{Binding IsLoading}" 
                             Height="5" 
                             Margin="0,10,0,0"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Оверлей загрузки -->
        <Border Grid.RowSpan="5" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="20"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                <TextBlock Text="{Binding StatusMessage}" 
                           Margin="0,10,0,0" 
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>