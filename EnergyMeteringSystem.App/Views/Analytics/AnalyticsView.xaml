<UserControl x:Class="EnergyMeteringSystem.App.Views.Analytics.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Панель выбора периода -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Год:" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Years}" 
                          SelectedItem="{Binding SelectedYear}"
                          Width="80" Margin="5"/>

                <TextBlock Text="Месяц:" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <ComboBox ItemsSource="{Binding Months}" 
                          SelectedItem="{Binding SelectedMonthName}"
                          Width="100" Margin="5"/>

                <Button Content="Обновить" 
                        Command="{Binding RefreshCommand}"
                        Padding="10,5" Margin="15,0,0,0"/>
            </StackPanel>

            <!-- Графики -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ТОП-10 объектов -->
                <Border Grid.Column="0" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="ТОП-10 объектов по потреблению" 
                                   FontSize="14" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <lvc:CartesianChart Series="{Binding TopObjectsSeries}" 
                    LegendLocation="Top"
                    Height="300"
                    Width="400"
                    DisableAnimations="True"                                            >
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Объект" Labels="{Binding TopObjectsLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Потребление (кВт·ч)" LabelFormatter="{Binding XFormatter}"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- Распределение по типам -->
                <Border Grid.Column="1" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Распределение по типам объектов" 
                                   FontSize="14" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <lvc:PieChart Series="{Binding TypeDistributionSeries}" 
                                      Height="300"
                                      Width="400"
                                      LegendLocation="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Карточки с итогами -->
            <Border Grid.Row="2" Background="#E3F2FD" Padding="10" CornerRadius="5" Margin="0,0,0,15">
                <WrapPanel HorizontalAlignment="Center">
                    <Border Background="#2196F3" Padding="15,10" CornerRadius="5" Margin="5" Width="180">
                        <StackPanel>
                            <TextBlock Text="Общее потребление" Foreground="White" FontSize="11" TextAlignment="Center"/>
                            <TextBlock Text="{Binding TotalConsumption, StringFormat={}{0:F0} кВт·ч}" 
                                       Foreground="White" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#4CAF50" Padding="15,10" CornerRadius="5" Margin="5" Width="180">
                        <StackPanel>
                            <TextBlock Text="Среднее на объект" Foreground="White" FontSize="11" TextAlignment="Center"/>
                            <TextBlock Text="{Binding AverageConsumption, StringFormat={}{0:F0} кВт·ч}" 
                                       Foreground="White" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FF9800" Padding="15,10" CornerRadius="5" Margin="5" Width="180">
                        <StackPanel>
                            <TextBlock Text="Максимум" Foreground="White" FontSize="11" TextAlignment="Center"/>
                            <TextBlock Text="{Binding MaxConsumption, StringFormat={}{0:F0} кВт·ч}" 
                                       Foreground="White" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Border>

            <!-- Таблица ТОП объектов -->
            <Border Grid.Row="3" Background="White" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Детальный список ТОП объектов" 
                               FontSize="14" FontWeight="Bold" 
                               Margin="0,0,0,10"/>

                    <DataGrid ItemsSource="{Binding TopObjects}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="250"
                              MinHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Rank}" Width="50"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="300"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding ObjectType}" Width="100"/>
                            <DataGridTextColumn Header="Потребление (кВт·ч)" Binding="{Binding Consumption, StringFormat=N0}" Width="120"/>
                            <DataGridTextColumn Header="% от общего" Binding="{Binding Percentage, StringFormat=F1}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>