<UserControl x:Class="EnergyMeteringSystem.App.Views.Analytics.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:converters="clr-namespace:EnergyMeteringSystem.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Панель выбора периода -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Год:" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DataGridForegroundBrush}"/>
                    <ComboBox ItemsSource="{Binding Years}" 
                              SelectedItem="{Binding SelectedYear}"
                              Width="80" 
                              Margin="5"
                              Background="{DynamicResource DataGridBackgroundBrush}"
                              Foreground="{DynamicResource DataGridForegroundBrush}"
                              BorderBrush="{DynamicResource DataGridBorderBrush}"/>

                    <TextBlock Text="Месяц:" 
                               VerticalAlignment="Center" 
                               Margin="15,0,0,0"
                               Foreground="{DynamicResource DataGridForegroundBrush}"/>
                    <ComboBox ItemsSource="{Binding Months}" 
                              SelectedItem="{Binding SelectedMonthName}"
                              Width="100" 
                              Margin="5"
                              Background="{DynamicResource DataGridBackgroundBrush}"
                              Foreground="{DynamicResource DataGridForegroundBrush}"
                              BorderBrush="{DynamicResource DataGridBorderBrush}"/>
                </StackPanel>

                <!-- Графики -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ТОП-10 объектов -->
                    <Border Grid.Column="0" 
                            Background="{DynamicResource DataGridAlternatingBrush}" 
                            Padding="10" 
                            CornerRadius="5" 
                            Margin="0,0,10,0"
                            BorderBrush="{DynamicResource DataGridBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ТОП-10 объектов по потреблению" 
                                       FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource DataGridForegroundBrush}"/>

                            <lvc:CartesianChart Series="{Binding TopObjectsSeries}" 
                                                LegendLocation="Top"
                                                Height="300"
                                                Width="400"
                                                DisableAnimations="True"
                                                Background="{DynamicResource DataGridBackgroundBrush}"
                                                Foreground="{DynamicResource DataGridForegroundBrush}">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Объект" 
                                              Labels="{Binding TopObjectsLabels}"
                                              Foreground="{DynamicResource DataGridForegroundBrush}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Stroke="{DynamicResource DataGridCellBorderBrush}"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Потребление (кВт·ч)" 
                                              LabelFormatter="{Binding XFormatter}"
                                              Foreground="{DynamicResource DataGridForegroundBrush}">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Stroke="{DynamicResource DataGridCellBorderBrush}"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </Border>

                    <!-- Распределение по типам -->
                    <Border Grid.Column="1" 
                            Background="{DynamicResource DataGridAlternatingBrush}" 
                            Padding="10" 
                            CornerRadius="5" 
                            Margin="10,0,0,0"
                            BorderBrush="{DynamicResource DataGridBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Распределение по типам объектов" 
                                       FontSize="14" FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource DataGridForegroundBrush}"/>

                            <lvc:PieChart Series="{Binding TypeDistributionSeries}" 
                                          Height="300"
                                          Width="400"
                                          LegendLocation="Right"
                                          Background="{DynamicResource DataGridBackgroundBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Карточки с итогами -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource DataGridSelectedBrush}" 
                        Padding="10" 
                        CornerRadius="5" 
                        Margin="0,0,0,15"
                        BorderBrush="{DynamicResource DataGridBorderBrush}"
                        BorderThickness="1">
                    <WrapPanel HorizontalAlignment="Center">
                        <!-- Карточка "Общее потребление" -->
                        <Border Background="{DynamicResource ButtonBackgroundBrush}" 
                                Padding="15,10" 
                                CornerRadius="5" 
                                Margin="5" 
                                Width="180">
                            <StackPanel>
                                <TextBlock Text="Общее потребление" 
                                           Foreground="White" 
                                           FontSize="11" 
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding TotalConsumption, StringFormat={}{0:F0} кВт·ч}" 
                                           Foreground="White" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Карточка "Среднее на объект" -->
                        <Border Background="{StaticResource SuccessButtonBrush}" 
                                Padding="15,10" 
                                CornerRadius="5" 
                                Margin="5" 
                                Width="180">
                            <StackPanel>
                                <TextBlock Text="Среднее на объект" 
                                           Foreground="White" 
                                           FontSize="11" 
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding AverageConsumption, StringFormat={}{0:F0} кВт·ч}" 
                                           Foreground="White" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Карточка "Максимум" -->
                        <Border Background="#E65100" 
                                Padding="15,10" 
                                CornerRadius="5" 
                                Margin="5" 
                                Width="180">
                            <StackPanel>
                                <TextBlock Text="Максимум" 
                                           Foreground="White" 
                                           FontSize="11" 
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding MaxConsumption, StringFormat={}{0:F0} кВт·ч}" 
                                           Foreground="White" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>

                <!-- Таблица ТОП объектов -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource DataGridBackgroundBrush}" 
                        Padding="10" 
                        Margin="0,0,0,10"
                        BorderBrush="{DynamicResource DataGridBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Детальный список ТОП объектов" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource DataGridForegroundBrush}"/>

                        <DataGrid ItemsSource="{Binding TopObjects}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="250"
                                  MinHeight="150"
                                  AlternatingRowBackground="{DynamicResource DataGridAlternatingBrush}"
                                  AlternationCount="2"
                                  Background="{DynamicResource DataGridBackgroundBrush}"
                                  BorderBrush="{DynamicResource DataGridBorderBrush}"
                                  RowHeaderWidth="0"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding Rank}" Width="50"/>
                                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="300"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding ObjectType}" Width="100"/>
                                <DataGridTextColumn Header="Потребление (кВт·ч)" Binding="{Binding Consumption, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="% от общего" Binding="{Binding Percentage, StringFormat=F1}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Индикатор загрузки -->
        <Border Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="20"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                <TextBlock Text="Загрузка данных..." 
                           Margin="0,10,0,0" 
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>