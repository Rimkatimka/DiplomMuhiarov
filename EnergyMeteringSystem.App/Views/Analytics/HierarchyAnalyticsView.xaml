<UserControl x:Class="EnergyMeteringSystem.App.Views.Analytics.HierarchyAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EnergyMeteringSystem.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Выбор периода -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Год:" VerticalAlignment="Center" Foreground="{DynamicResource DataGridForegroundBrush}"/>
            <ComboBox ItemsSource="{Binding Years}" 
                      SelectedItem="{Binding SelectedYear}"
                      Width="80" Margin="5"
                      Background="{DynamicResource DataGridBackgroundBrush}"
                      Foreground="{DynamicResource DataGridForegroundBrush}"
                      BorderBrush="{DynamicResource DataGridBorderBrush}"/>

            <TextBlock Text="Месяц:" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{DynamicResource DataGridForegroundBrush}"/>
            <ComboBox ItemsSource="{Binding Months}" 
                      SelectedItem="{Binding SelectedMonthName}"
                      Width="100" Margin="5"
                      Background="{DynamicResource DataGridBackgroundBrush}"
                      Foreground="{DynamicResource DataGridForegroundBrush}"
                      BorderBrush="{DynamicResource DataGridBorderBrush}"/>
        </StackPanel>

        <!-- Регионы с прокруткой -->
        <Border Grid.Row="1" 
                Background="{DynamicResource DataGridAlternatingBrush}" 
                Padding="10" 
                CornerRadius="5"
                Margin="0,0,0,10"
                MaxHeight="200">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="📍 Регионы" 
                               FontSize="14" FontWeight="Bold" 
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource DataGridForegroundBrush}"/>

                    <ItemsControl ItemsSource="{Binding Regions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" 
                                        Padding="12,10"
                                        Cursor="Hand"
                                        Margin="0,0,0,3"
                                        CornerRadius="6"
                                        BorderBrush="Transparent"
                                        BorderThickness="2"
                                        MouseLeftButtonUp="RegionBorder_MouseLeftButtonUp"
                                        Tag="{Binding}">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DataGridSelectedBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DataGridSelectedBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="📍 " FontSize="16" Foreground="{DynamicResource ButtonBackgroundBrush}"/>
                                            <TextBlock Text="{Binding RegionName}" 
                                                       FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource DataGridForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding TotalConsumption, StringFormat={}{0:N0} кВт·ч}" 
                                                   Foreground="{DynamicResource ButtonBackgroundBrush}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="2" 
                                                Background="{DynamicResource DataGridBorderBrush}"
                                                CornerRadius="12" Padding="8,2" Margin="5,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource DataGridForegroundBrush}">
                                                <Run Text="{Binding ObjectsCount}"/>
                                                <Run Text=" объектов"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Детали -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasSelectedRegion, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <!-- Информация о регионе -->
                <Border Background="{DynamicResource DataGridAlternatingBrush}" 
                        Padding="15" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedRegionData.RegionName}" 
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource DataGridForegroundBrush}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource ButtonBackgroundBrush}" 
                                    Padding="10" CornerRadius="5" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="Потребление" Foreground="White" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedRegionData.TotalConsumption, StringFormat={}{0:N0} кВт·ч}" 
                                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource SuccessButtonBrush}" 
                                    Padding="10" CornerRadius="5" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="Объектов" Foreground="White" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedRegionData.ObjectsCount}" 
                                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#E65100" 
                                    Padding="10" CornerRadius="5" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="Городов" Foreground="White" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedRegionData.Cities.Count}" 
                                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ТОП-10 объектов региона -->
                <Border Background="{DynamicResource DataGridAlternatingBrush}" 
                        Padding="15" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🏆 ТОП-10 объектов региона" 
                                   FontSize="14" FontWeight="Bold" 
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource DataGridForegroundBrush}"/>

                        <DataGrid ItemsSource="{Binding TopObjects}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="200"
                                  AlternatingRowBackground="{DynamicResource DataGridAlternatingBrush}"
                                  Background="{DynamicResource DataGridBackgroundBrush}"
                                  BorderBrush="{DynamicResource DataGridBorderBrush}"
                                  RowHeaderWidth="0"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="180"/>
                                <DataGridTextColumn Header="Дом" Binding="{Binding HouseNumber}" Width="60"/>
                                <DataGridTextColumn Header="Кв." Binding="{Binding ApartmentNumber}" Width="50"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding ObjectType}" Width="100"/>
                                <DataGridTextColumn Header="Потребление" Binding="{Binding Consumption, StringFormat={}{0:N0} кВт·ч}" Width="120"/>
                                <DataGridTextColumn Header="% от региона" Binding="{Binding Percentage, StringFormat={}{0:F1}%}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- 🔍 ПОИСК ПО ГОРОДАМ -->
                <TextBox Text="{Binding SearchCities, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"
                         Padding="8,5"
                         Foreground="{DynamicResource DataGridForegroundBrush}"
                         Background="{DynamicResource DataGridBackgroundBrush}"
                         BorderBrush="{DynamicResource DataGridBorderBrush}"
                         BorderThickness="1"
                         ToolTip="Поиск по названию города"/>

                <!-- Города -->
                <ItemsControl ItemsSource="{Binding FilteredCities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding CityName}" 
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource DataGridForegroundBrush}"
                                      Margin="0,0,0,5"
                                      IsExpanded="True">

                                <StackPanel Margin="15,10,0,10">
                                    <!-- Информация о городе -->
                                    <Border Background="{DynamicResource DataGridAlternatingBrush}" 
                                            Padding="10" CornerRadius="5" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource ButtonBackgroundBrush}" 
                                                    Padding="5" CornerRadius="5" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Потребление" Foreground="White" FontSize="9"/>
                                                    <TextBlock Text="{Binding TotalConsumption, StringFormat={}{0:N0} кВт·ч}" 
                                                               Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SuccessButtonBrush}" 
                                                    Padding="5" CornerRadius="5" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Объектов" Foreground="White" FontSize="9"/>
                                                    <TextBlock Text="{Binding ObjectsCount}" 
                                                               Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="#E65100" 
                                                    Padding="5" CornerRadius="5" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="Улиц" Foreground="White" FontSize="9"/>
                                                    <TextBlock Text="{Binding Streets.Count}" 
                                                               Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Улицы -->
                                    <Border Background="{DynamicResource DataGridBackgroundBrush}" 
                                            Padding="5" CornerRadius="5"
                                            BorderBrush="{DynamicResource DataGridBorderBrush}"
                                            BorderThickness="1"
                                            MaxHeight="300">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Streets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander Header="{Binding StreetName}" 
                                                                  FontWeight="Normal"
                                                                  Foreground="{DynamicResource DataGridForegroundBrush}"
                                                                  Margin="10,0,0,5">

                                                            <StackPanel Margin="15,10,0,10">
                                                                <!-- Информация об улице -->
                                                                <Border Background="{DynamicResource DataGridAlternatingBrush}" 
                                                                        Padding="8" CornerRadius="5" Margin="0,0,0,10">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Background="{DynamicResource ButtonBackgroundBrush}" 
                                                                                Padding="5" CornerRadius="5" Margin="3">
                                                                            <StackPanel>
                                                                                <TextBlock Text="Потребление" Foreground="White" FontSize="9"/>
                                                                                <TextBlock Text="{Binding TotalConsumption, StringFormat={}{0:N0} кВт·ч}" 
                                                                                           Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Grid.Column="1" Background="{StaticResource SuccessButtonBrush}" 
                                                                                Padding="5" CornerRadius="5" Margin="3">
                                                                            <StackPanel>
                                                                                <TextBlock Text="Объектов" Foreground="White" FontSize="9"/>
                                                                                <TextBlock Text="{Binding ObjectsCount}" 
                                                                                           Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border Grid.Column="2" Background="#E65100" 
                                                                                Padding="5" CornerRadius="5" Margin="3">
                                                                            <StackPanel>
                                                                                <TextBlock Text="Среднее" Foreground="White" FontSize="9"/>
                                                                                <TextBlock Text="{Binding AveragePerObject, StringFormat={}{0:N0} кВт·ч}" 
                                                                                           Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Объекты -->
                                                                <Border MaxHeight="200">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <DataGrid ItemsSource="{Binding Objects}"
                                                                                  AutoGenerateColumns="False"
                                                                                  IsReadOnly="True"
                                                                                  AlternatingRowBackground="{DynamicResource DataGridAlternatingBrush}"
                                                                                  Background="{DynamicResource DataGridBackgroundBrush}"
                                                                                  BorderBrush="{DynamicResource DataGridBorderBrush}"
                                                                                  RowHeaderWidth="0"
                                                                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                                                                  CellStyle="{StaticResource DataGridCellStyle}">

                                                                            <DataGrid.Resources>
                                                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                                                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                                                                            </DataGrid.Resources>

                                                                            <DataGrid.Columns>
                                                                                <DataGridTextColumn Header="Дом" Binding="{Binding HouseNumber}" Width="60"/>
                                                                                <DataGridTextColumn Header="Кв." Binding="{Binding ApartmentNumber}" Width="50"/>
                                                                                <DataGridTextColumn Header="Тип" Binding="{Binding ObjectType}" Width="100"/>
                                                                                <DataGridTextColumn Header="Потребление" Binding="{Binding Consumption, StringFormat={}{0:N0} кВт·ч}" Width="120"/>
                                                                                <DataGridTextColumn Header="% от улицы" Binding="{Binding Percentage, StringFormat={}{0:F1}%}" Width="80"/>
                                                                            </DataGrid.Columns>
                                                                        </DataGrid>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Индикатор загрузки -->
        <Border Grid.RowSpan="3" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20"/>
                <TextBlock Text="Загрузка аналитики..." Margin="0,10,0,0" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>