<UserControl x:Class="EnergyMeteringSystem.App.Views.Directories.DynamicDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EnergyMeteringSystem.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" 
                Background="{DynamicResource DataGridAlternatingBrush}" 
                Padding="10" 
                CornerRadius="5"
                Margin="0,0,0,10"
                BorderBrush="{DynamicResource DataGridBorderBrush}"
                BorderThickness="1">
            <WrapPanel>
                <TextBlock Text="Справочник:" 
                           VerticalAlignment="Center" 
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource DataGridForegroundBrush}"/>

                <ComboBox ItemsSource="{Binding AvailableTables}"
                          SelectedValue="{Binding SelectedTableName}"
                          
                          SelectedValuePath="TableName"
                          DisplayMemberPath="RussianName"
                          Width="250"
                          Margin="0,0,20,0"
                          Background="{DynamicResource DataGridBackgroundBrush}"
                          Foreground="{DynamicResource DataGridForegroundBrush}"
                          BorderBrush="{DynamicResource DataGridBorderBrush}"/>

                <TextBlock Text="{Binding CurrentTableRussianName}" 
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,20,0"
                           Foreground="{DynamicResource MenuAccentBrush}"/>

                <TextBlock Text="Поиск:" 
                           VerticalAlignment="Center" 
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource DataGridForegroundBrush}"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="250"
                         Padding="8,6"
                         Background="{DynamicResource DataGridBackgroundBrush}"
                         Foreground="{DynamicResource DataGridForegroundBrush}"
                         BorderBrush="{DynamicResource DataGridBorderBrush}"/>
            </WrapPanel>
        </Border>

        <!-- Таблица -->
        <Grid Grid.Row="1">
            <DataGrid x:Name="DirectoryDataGrid"
                      ItemsSource="{Binding GridData}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="DirectoryDataGrid_AutoGeneratingColumn"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      AlternatingRowBackground="{DynamicResource DataGridAlternatingBrush}"
                      AlternationCount="2"
                      Background="{DynamicResource DataGridBackgroundBrush}"
                      BorderBrush="{DynamicResource DataGridBorderBrush}"
                      RowHeaderWidth="0"
                      IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                </DataGrid.Resources>
            </DataGrid>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0">

            <Button Content="➕ Добавить" 
                    Command="{Binding AddCommand}"
                    Padding="15,5" 
                    Margin="5"
                    Background="{StaticResource SuccessButtonBrush}" 
                    Foreground="White"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>

            <Button Content="✏ Редактировать" 
                    Command="{Binding EditCommand}"
                    Padding="15,5" 
                    Margin="5"
                    Background="{DynamicResource ButtonBackgroundBrush}" 
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>

            <Button Content="🗑 Удалить" 
                    Command="{Binding DeleteCommand}"
                    Padding="15,5" 
                    Margin="5"
                    Background="{StaticResource DangerButtonBrush}" 
                    Foreground="White"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Загрузка -->
        <Border Grid.RowSpan="3" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="20"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                <TextBlock Text="Загрузка..." 
                           Margin="0,10,0,0" 
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
