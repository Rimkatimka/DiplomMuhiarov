<Window x:Class="EnergyMeteringSystem.App.Views.Directories.StreetEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление улицы" 
        Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Город -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Город:" Margin="5" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CityName}" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>

        <!-- Название улицы -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Название улицы:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" 
                 Text="{Binding Name}" 
                 Margin="5" Padding="5"
                 MaxLength="100"
                 PreviewTextInput="TextBox_PreviewTextInput_StreetName"
                 IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Почтовый индекс -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Почтовый индекс:" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" 
                 Text="{Binding PostalCode}" 
                 Margin="5" Padding="5"
                 MaxLength="20"
                 IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" 
                    Command="{Binding SaveCommand}"
                    Padding="20,8" Margin="5"
                    Background="#4CAF50" Foreground="White"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Отмена" 
                    Command="{Binding CancelCommand}"
                    Padding="20,8" Margin="5"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Индикатор загрузки -->
        <Border Grid.RowSpan="4" Grid.ColumnSpan="2" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20"/>
                <TextBlock Text="Сохранение..." Margin="0,10,0,0" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>