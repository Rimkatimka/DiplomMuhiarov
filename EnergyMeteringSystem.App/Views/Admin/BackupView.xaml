<UserControl x:Class="EnergyMeteringSystem.App.Views.Admin.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Резервное копирование базы данных" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Создание бэкапа -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📀 СОЗДАНИЕ РЕЗЕРВНОЙ КОПИИ" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding BackupPath}" 
                             Width="400" Padding="5" Margin="5"
                             IsReadOnly="True"/>
                    <Button Content="Обзор" 
                            Command="{Binding BrowseBackupCommand}"
                            Padding="15,5" Margin="5"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <Button Content="Создать резервную копию" 
                        Command="{Binding CreateBackupCommand}"
                        Padding="20,8" Margin="5,10,5,5"
                        Background="#4CAF50" Foreground="White"
                        Width="200" HorizontalAlignment="Left"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Восстановление из бэкапа -->
        <Border Grid.Row="2" Background="#FFF3E0" Padding="10" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="🔄 ВОССТАНОВЛЕНИЕ ИЗ РЕЗЕРВНОЙ КОПИИ" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="ВНИМАНИЕ: Восстановление заменит все текущие данные!" 
                           Foreground="Red" FontSize="11" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding RestorePath}" 
                             Width="400" Padding="5" Margin="5"
                             IsReadOnly="True"/>
                    <Button Content="Выбрать файл" 
                            Command="{Binding BrowseRestoreCommand}"
                            Padding="15,5" Margin="5"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <Button Content="Восстановить из копии" 
                        Command="{Binding RestoreCommand}"
                        Padding="20,8" Margin="5,10,5,5"
                        Background="#FF9800" Foreground="White"
                        Width="200" HorizontalAlignment="Left"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Статус -->
        <Border Grid.Row="3" Background="#E3F2FD" Padding="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="📊 СТАТУС" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="{Binding IsLoading}" 
                             Height="5" Margin="0,10,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Оверлей загрузки (блокирует весь экран) -->
        <Border Grid.RowSpan="5" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>