<UserControl x:Class="EnergyMeteringSystem.App.Views.Admin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EnergyMeteringSystem.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="300" 
                     Padding="8,6"
                     VerticalAlignment="Center"
                     IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                     Background="{DynamicResource DataGridBackgroundBrush}"
                     Foreground="{DynamicResource DataGridForegroundBrush}"
                     BorderBrush="{DynamicResource DataGridBorderBrush}"
                     BorderThickness="1"
                     FontSize="13"
                     ToolTip="Поиск по ФИО, логину или email"/>
        </StackPanel>

        <!-- Таблица пользователей -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding FilteredItems}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingBrush}"
                  AlternationCount="2"
                  Background="{DynamicResource DataGridBackgroundBrush}"
                  BorderBrush="{DynamicResource DataGridBorderBrush}"
                  RowHeaderWidth="0"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  CellStyle="{StaticResource DataGridCellStyle}">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding RoleText}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedText}" Width="100"/>
                <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLoginText}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки действий с семантическими цветами -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="➕ Добавить" 
                    Command="{Binding AddCommand}"
                    Padding="15,5" Margin="5"
                    Background="{StaticResource SuccessButtonBrush}" 
                    Foreground="White"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>

            <Button Content="✏ Редактировать" 
                    Command="{Binding EditCommand}"
                    Padding="15,5" Margin="5"
                    Background="{DynamicResource ButtonBackgroundBrush}" 
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>

            <Button Content="🔒 Блокировать/Разблокировать" 
                    Command="{Binding BlockCommand}"
                    Padding="15,5" Margin="5"
                    Background="#E65100" 
                    Foreground="White"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>

            <Button Content="🔑 Сброс пароля" 
                    Command="{Binding ResetPasswordCommand}"
                    Padding="15,5" Margin="5"
                    Background="#757575" 
                    Foreground="White"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>

            <Button Content="🗑 Удалить" 
                    Command="{Binding DeleteCommand}"
                    Padding="15,5" Margin="5"
                    Background="{StaticResource DangerButtonBrush}" 
                    Foreground="White"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                    Cursor="Hand"
                    FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Индикатор загрузки (оверлей) -->
        <Border Grid.RowSpan="3" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="20"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                <TextBlock Text="Загрузка пользователей..." 
                           Margin="0,10,0,0" 
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>