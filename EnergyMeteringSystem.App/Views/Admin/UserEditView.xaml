<UserControl x:Class="EnergyMeteringSystem.App.Views.Admin.UserEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EnergyMeteringSystem.App.Views.Admin">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Логин -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Логин:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" 
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                     Margin="5" Padding="5"
                     IsReadOnly="{Binding IsSelfEdit}"/>

            <!-- ФИО -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="ФИО:" Margin="5" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" 
                     Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                     Margin="5" Padding="5"/>

            <!-- Email -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" Margin="5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical">
                <TextBox 
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Margin="5" Padding="5"/>
                <TextBlock Text="{Binding EmailError}" 
                           Foreground="Red" 
                           FontSize="11"
                           Margin="5,0,5,5"
                           Visibility="{Binding ShowEmailError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Роль -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Роль:" Margin="5" VerticalAlignment="Center"/>

            <ComboBox Grid.Row="3" Grid.Column="1" 
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      DisplayMemberPath="Name"
                      Margin="5" Padding="5"
                      Visibility="{Binding IsSelfEdit, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Grid.Row="3" Grid.Column="1" 
                       Text="{Binding SelectedRole.Name}"
                       Margin="5" Padding="5"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsSelfEdit, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Новый пароль (только для саморедактирования) -->
            <TextBlock Grid.Row="4" Grid.Column="0" 
                       Text="Новый пароль:" 
                       Margin="5" VerticalAlignment="Center"
                       Visibility="{Binding IsSelfEdit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <PasswordBox x:Name="NewPasswordBox" 
                         Grid.Row="4" Grid.Column="1" 
                         Margin="5" Padding="5"
                         PasswordChanged="NewPasswordBox_PasswordChanged"
                         Visibility="{Binding IsSelfEdit, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Подтверждение пароля -->
            <TextBlock Grid.Row="5" Grid.Column="0" 
                       Text="Подтверждение:" 
                       Margin="5" VerticalAlignment="Center"
                       Visibility="{Binding IsSelfEdit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" 
                         Grid.Row="5" Grid.Column="1" 
                         Margin="5" Padding="5"
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                         Visibility="{Binding IsSelfEdit, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Ошибка пароля -->
            <TextBlock Grid.Row="6" Grid.Column="1" 
                       Text="{Binding PasswordError}"
                       Foreground="Red"
                       FontSize="11"
                       Margin="5,0,5,5"
                       Visibility="{Binding HasPasswordError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Сохранить" 
                        Command="{Binding SaveCommand}"
                        Padding="20,8" Margin="5"
                        Background="#4CAF50" Foreground="White"/>
                <Button Content="Отмена" 
                        Command="{Binding CancelCommand}"
                        Padding="20,8" Margin="5"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>