<UserControl x:Class="EnergyMeteringSystem.App.Views.Admin.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Фильтры -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="С:" VerticalAlignment="Center" Margin="5"/>
            <DatePicker SelectedDate="{Binding FromDate}" Width="120" Margin="5"/>
            <TextBlock Text="По:" VerticalAlignment="Center" Margin="5"/>
            <DatePicker SelectedDate="{Binding ToDate}" Width="120" Margin="5"/>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="200" Padding="5" Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     ToolTip="Поиск по пользователю, действию, таблице"/>
        </StackPanel>

        <!-- Таблица логов -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding FilteredItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="#F5F5F5"
                  AlternationCount="2"
                  IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D3F5E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="35"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="150"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding UserDisplay}" Width="150"/>
                <DataGridTextColumn Header="Действие" Binding="{Binding ActionText}" Width="120"/>
                <DataGridTextColumn Header="Таблица" Binding="{Binding TableName}" Width="120"/>
                <DataGridTextColumn Header="ID записи" Binding="{Binding RecordId}" Width="80"/>
                <DataGridTextColumn Header="Детали" Binding="{Binding DisplayDetails}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Индикатор загрузки (поверх таблицы) -->
        <Border Grid.Row="1" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20"/>
                <TextBlock Text="Загрузка журнала аудита..." Margin="0,10,0,0" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Сообщение если нет данных -->
        <TextBlock Grid.Row="1" 
                   Text="Нет записей в журнале аудита за выбранный период"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="Gray"
                   Visibility="{Binding FilteredItems.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
    </Grid>
</UserControl>