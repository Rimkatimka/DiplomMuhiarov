<UserControl x:Class="EnergyMeteringSystem.App.Views.Admin.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EnergyMeteringSystem.App.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Фильтры -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="С:" 
                       VerticalAlignment="Center" 
                       Margin="5"
                       Foreground="{DynamicResource DataGridForegroundBrush}"/>
            <DatePicker SelectedDate="{Binding FromDate}" 
                        Width="120" 
                        Margin="5"
                        Background="{DynamicResource DataGridBackgroundBrush}"
                        Foreground="{DynamicResource DataGridForegroundBrush}"
                        BorderBrush="{DynamicResource DataGridBorderBrush}"/>

            <TextBlock Text="По:" 
                       VerticalAlignment="Center" 
                       Margin="5"
                       Foreground="{DynamicResource DataGridForegroundBrush}"/>
            <DatePicker SelectedDate="{Binding ToDate}" 
                        Width="120" 
                        Margin="5"
                        Background="{DynamicResource DataGridBackgroundBrush}"
                        Foreground="{DynamicResource DataGridForegroundBrush}"
                        BorderBrush="{DynamicResource DataGridBorderBrush}"/>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="200" 
                     Padding="8,6" 
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     ToolTip="Поиск по пользователю, действию, таблице"
                     Background="{DynamicResource DataGridBackgroundBrush}"
                     Foreground="{DynamicResource DataGridForegroundBrush}"
                     BorderBrush="{DynamicResource DataGridBorderBrush}"
                     BorderThickness="1"/>
        </StackPanel>

        <!-- Таблица логов -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding FilteredLogs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingBrush}"
                  AlternationCount="2"
                  Background="{DynamicResource DataGridBackgroundBrush}"
                  BorderBrush="{DynamicResource DataGridBorderBrush}"
                  RowHeaderWidth="0"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  CellStyle="{StaticResource DataGridCellStyle}">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="150"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding UserDisplay}" Width="150"/>
                <DataGridTextColumn Header="Действие" Binding="{Binding ActionText}" Width="120"/>
                <DataGridTextColumn Header="Таблица" Binding="{Binding TableName}" Width="120"/>
                <DataGridTextColumn Header="ID записи" Binding="{Binding RecordId}" Width="80"/>
                <DataGridTextColumn Header="Детали" Binding="{Binding DisplayDetails}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Индикатор загрузки -->
        <Border Grid.RowSpan="2" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="20"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                <TextBlock Text="Загрузка журнала аудита..." 
                           Margin="0,10,0,0" 
                           Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Сообщение если нет данных -->
        <TextBlock Grid.Row="1" 
                   Text="Нет записей в журнале аудита за выбранный период"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource MenuForegroundSecondaryBrush}"
                   Visibility="{Binding FilteredItemsList.Count, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
    </Grid>
</UserControl>