<UserControl x:Class="EnergyMeteringSystem.App.Views.Readings.MeterReadingInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                CornerRadius="5" 
                                Padding="10"
                                Margin="0,0,0,5"
                                Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MeterListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                CornerRadius="5" 
                                Padding="10"
                                Margin="0,0,0,5"
                                Background="#F5F5F5"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E8F5E9"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="🔍 Поиск объекта" Margin="0,0,0,10">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="5" Padding="5"
                             MaxLength="50"
                             ToolTip="Введите адрес для поиска"
                             FontSize="14"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </GroupBox>

                <TextBlock Grid.Row="1" 
                           Text="📋 Выберите объект:"
                           FontWeight="Bold"
                           Margin="5,0,5,5"
                           FontSize="14"/>

                <ListBox Grid.Row="2" 
                         ItemsSource="{Binding FilteredObjects}"
                         SelectedItem="{Binding SelectedObject}"
                         Height="150"
                         Margin="0,0,0,10"
                         HorizontalContentAlignment="Stretch"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Address}" 
                                           FontWeight="Bold"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ObjectTypeName}" 
                                           FontSize="11"
                                           Foreground="Gray"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Площадь: " FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{Binding TotalArea, StringFormat={}{0:F1} м²}" FontSize="11"/>
                                    <TextBlock Text=" | Жильцов: " FontSize="11" Foreground="Gray" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding ResidentCount}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" 
                           Text="🔌 Счетчики выбранного объекта:"
                           FontWeight="Bold"
                           Margin="5,10,5,5"
                           FontSize="14"
                           Visibility="{Binding HasSelectedObject, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <ListBox Grid.Row="4" 
                         ItemsSource="{Binding Meters}"
                         SelectedItem="{Binding SelectedMeter}"
                         Height="120"
                         Margin="0,0,0,10"
                         Visibility="{Binding HasSelectedObject, Converter={StaticResource BooleanToVisibilityConverter}}"
                         ItemContainerStyle="{StaticResource MeterListBoxItemStyle}"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding SerialNumber}" 
                                           FontWeight="Bold"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding MeterTypeName}" 
                                           FontSize="11"
                                           Foreground="Gray"/>
                                <TextBlock Text="{Binding LastReadingInfo}" 
                                           FontSize="10"
                                           Foreground="#2196F3"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ← ДОБАВЛЕНО -->
                <Border Grid.Row="5" Background="#FFF9C4" Padding="10" CornerRadius="5" Margin="0,0,0,10"
                        Visibility="{Binding HasSelectedObject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="📊 Норма потребления" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Норма на чел.:" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NormConsumption, StringFormat={}{0:F2} кВт·ч}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Всего норма:" Margin="0,5,10,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalNormConsumption, StringFormat={}{0:F2} кВт·ч}" FontWeight="Bold" Foreground="#1976D2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Статус:" Margin="0,5,10,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NormStatus}" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <GroupBox Grid.Row="6" Header="📝 Ввод показаний" Margin="0,0,0,10"
                          Visibility="{Binding HasSelectedMeter, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Выбран счетчик:" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedMeter.SerialNumber}" Margin="5" VerticalAlignment="Center" FontWeight="Bold" Foreground="#4CAF50"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Период:" Margin="5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="📅 " VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PeriodDisplay}" 
                                       VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text=" (ввод за этот период)" 
                                       FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Показание:" Margin="5" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding ReadingValue, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="5" Padding="5"
                                 MaxLength="15"
                                 Width="150" HorizontalAlignment="Left"
                                 PreviewTextInput="TextBox_PreviewTextInput_Decimal"
                                 PreviewKeyDown="TextBox_PreviewKeyDown_BlockSpace"
                                 ToolTip="Только цифры, точка или запятая"
                                 FontSize="14"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </GroupBox>

                <Border Grid.Row="7" Background="#F5F5F5" Padding="10" CornerRadius="5" Margin="0,0,0,10"
                        Visibility="{Binding HasLastReading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 Последнее показание:" FontWeight="Bold" Margin="0,0,10,5" VerticalAlignment="Center"/>
                            <Button Content="Подставить значение"
                                    Command="{Binding SetLastReadingCommand}"
                                    Padding="10,3"
                                    Margin="0,0,0,5"
                                    Background="#2196F3"
                                    Foreground="White"
                                    FontSize="11"
                                    Cursor="Hand"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastReading.Value, StringFormat=Показание: {0:F2}}"/>
                        <TextBlock Text="{Binding LastReading.ReadingDate, StringFormat=Дата: {0:dd.MM.yyyy}}"/>
                        <TextBlock Text="{Binding LastReading.Consumption, StringFormat=Потребление: {0:F2} кВт}"/>
                    </StackPanel>
                </Border>

                <GroupBox Grid.Row="8" Header="📜 История показаний" Margin="0,0,0,10"
                          Visibility="{Binding HasReadingHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding ReadingHistory}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="150"
                              Margin="5"
                              IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding ReadingDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Показание" Binding="{Binding Value}" Width="100"/>
                            <DataGridTextColumn Header="Потребление" Binding="{Binding Consumption, StringFormat={}{0:F2} кВт}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <TextBlock Grid.Row="9" Text="{Binding WarningMessage}" 
                           Foreground="Red" FontWeight="Bold"
                           Margin="5" HorizontalAlignment="Center"
                           Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5,10,5,5">
                    <Button Content="💾 Сохранить" 
                            Command="{Binding SaveCommand}" 
                            Padding="20,8" Margin="5" Width="120"
                            Background="#4CAF50" Foreground="White"
                            Cursor="Hand"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="🗑 Очистить" 
                            Command="{Binding ClearCommand}" 
                            Padding="20,8" Margin="5" Width="120"
                            Cursor="Hand"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="150" Height="20"/>
                <TextBlock Text="Загрузка..." Margin="0,10,0,0" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>