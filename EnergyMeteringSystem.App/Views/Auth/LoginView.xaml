<Window x:Class="EnergyMeteringSystem.App.Views.Auth.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EnergyMeteringSystem.App.Converters"
        Title="Вход в систему" 
        Height="420" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MenuBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Учет электроэнергии" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource MenuForegroundBrush}"
                   Margin="0,0,0,30"/>

        <!-- Логин -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Имя пользователя" 
                       Margin="0,0,0,5"
                       Foreground="{DynamicResource MenuForegroundBrush}"/>
            <TextBox x:Name="LoginTextBox"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="10,8" 
                     FontSize="14"
                     MaxLength="50"
                     Background="{DynamicResource MenuInputBackgroundBrush}"
                     Foreground="{DynamicResource MenuForegroundBrush}"
                     BorderBrush="{DynamicResource MenuCardBackgroundBrush}"
                     BorderThickness="1"
                     CaretBrush="{DynamicResource MenuForegroundBrush}"
                     PreviewTextInput="LoginTextBox_PreviewTextInput"
                     PreviewKeyDown="LoginTextBox_PreviewKeyDown"
                     ToolTip="Только латиница, цифры, . _ -"
                     IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
        </StackPanel>

        <!-- Пароль с кнопкой показа -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Пароль" 
                       Margin="0,0,0,5"
                       Foreground="{DynamicResource MenuForegroundBrush}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="PasswordBox" 
                             Grid.Column="0"
                             Padding="10,8" 
                             FontSize="14"
                             MaxLength="256"
                             Background="{DynamicResource MenuInputBackgroundBrush}"
                             Foreground="{DynamicResource MenuForegroundBrush}"
                             BorderBrush="{DynamicResource MenuCardBackgroundBrush}"
                             BorderThickness="1"
                             CaretBrush="{DynamicResource MenuForegroundBrush}"
                             PreviewKeyDown="PasswordBox_PreviewKeyDown"
                             ToolTip="Пробел запрещён"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                <TextBox x:Name="VisiblePasswordTextBox" 
                         Grid.Column="0"
                         Padding="10,8" 
                         FontSize="14"
                         Visibility="Collapsed"
                         MaxLength="256"
                         Background="{DynamicResource MenuInputBackgroundBrush}"
                         Foreground="{DynamicResource MenuForegroundBrush}"
                         BorderBrush="{DynamicResource MenuCardBackgroundBrush}"
                         BorderThickness="1"
                         CaretBrush="{DynamicResource MenuForegroundBrush}"/>

                <!-- Кнопка глаза -->
                <Border Grid.Column="1"
                        Width="40" Height="35"
                        Margin="5,0,0,0"
                        Background="{DynamicResource MenuCardBackgroundBrush}"
                        BorderBrush="{DynamicResource MenuInputBackgroundBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Cursor="Hand">

                    <Button x:Name="TogglePasswordButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="TogglePasswordVisibility_Click"
                            ToolTip="Показать пароль"
                            Padding="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">

                        <Button.Content>
                            <TextBlock FontSize="16" 
                                       Text="👁" 
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MenuForegroundSecondaryBrush}"/>
                        </Button.Content>
                    </Button>
                </Border>
            </Grid>

            <!-- Подсказка под полем -->
            <TextBlock Text="Нажмите на глаз, чтобы показать/скрыть пароль"
                       FontSize="10"
                       Foreground="{DynamicResource MenuForegroundSecondaryBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Ошибка -->
        <TextBlock Grid.Row="3" 
                   Text="{Binding ErrorMessage}"
                   Foreground="#FF6B6B"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"
                   FontWeight="SemiBold"/>

        <!-- Кнопка входа -->
        <Button Grid.Row="4" 
                Command="{Binding LoginCommand}"
                Content="Войти"
                IsDefault="True"
                Height="45"
                Background="{DynamicResource ButtonBackgroundBrush}"
                Foreground="{DynamicResource ButtonForegroundBrush}"
                FontSize="14"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Индикатор загрузки (оверлей) -->
        <Border Grid.RowSpan="5" 
                Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Width="150" 
                             Height="20"
                             Foreground="{DynamicResource ProgressBarForegroundBrush}"
                             Background="{DynamicResource ProgressBarBackgroundBrush}"/>
                <TextBlock Text="Вход в систему..." 
                           Margin="0,10,0,0" 
                           Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>